# --- Database ---
# Vercel Postgres, Neon, or Supabase connection string
DATABASE_URL="postgresql://user:password@host:5432/team_scheduler?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-32-byte-secret"
# Your deployed URL (Vercel sets this automatically in prod via VERCEL_URL,
# but set it explicitly for local dev)
NEXTAUTH_URL="http://localhost:3000"

# --- Azure AD (Microsoft Entra ID) App Registration ---
# From Azure Portal > App registrations > your app > Overview / Certificates & secrets
AZURE_AD_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_AD_CLIENT_SECRET="your-client-secret-value"
AZURE_AD_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Team allowlist (MVP: comma-separated emails, case-insensitive) ---
# Alternative: leave blank and set ALLOWED_DOMAIN instead to allow a whole domain
ALLOWED_EMAILS="jsmith@yourcompany.com,adas@yourcompany.com"
ALLOWED_DOMAIN=""

# --- Token encryption ---
# 32-byte key (base64) used to encrypt refresh tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-random-32-byte-key"

# --- Email (SendGrid) ---
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="scheduler@yourcompany.com"

# --- Rate limiting (Upstash Redis - free tier is fine) ---
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
